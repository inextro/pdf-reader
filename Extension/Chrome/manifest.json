{
  "manifest_version": 3,
  "name": "Save to PaperLibrary",
  "version": "1.0.0",
  "description": "Save the paper on this page, with its PDF, to PaperLibrary.",
  "action": {
    "default_title": "Save to PaperLibrary",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "tabs", "downloads"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" } }
  }
}
